# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Environment & secrets
.env
.env.*
!.env.example

# Data (populated at runtime or via volumes)
data/raw/
data/processed/*
!data/processed/ja/
data/processed/ja/*
!data/processed/ja/kanji_table.json
!data/processed/ja/headword_index.marisa
!data/processed/ja/strokes.json
data/monitoring/

# Models (pre-warmed in Dockerfile or mounted)
models/

# Evaluation outputs (not needed in container)
eval/
eval/results/

# Git
.git/
.gitignore
.gitattributes

# Documentation & planning
README.md
docs/

# Frontend (SvelteKit) — root context; keep the lightweight source, not the
# build state or secrets (the web image builds from this root context, so the
# old web/.dockerignore is folded in here and that file is gone).
web/node_modules/
web/.svelte-kit/
web/build/
web/.vite/
web/.env
web/.env.*
!web/.env.example

# IDE & editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Misc
*.log
local/
