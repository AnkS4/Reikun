# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Application ──────────────────────────────────────────────────────────────
# Port on which the Streamlit application will be accessible on the host
APP_PORT=8000

# ── Cohere ───────────────────────────────────────────────────────────────────
# Required for the /explain (grammar explanation) endpoint.
# Get your key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# ── Qdrant ───────────────────────────────────────────────────────────────────
# Defaults below match the docker-compose.yml configuration.
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Name of the Qdrant collection holding JMdict word/example chunks.
QDRANT_COLLECTION=jmdict_chunks

# ── Retrieval tuning ─────────────────────────────────────────────────────────
# Dense embedding model (fastembed). Chosen via eval/embed_model_bench.py —
# see eval/results/embed_model_bench.json for the comparison.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder re-ranking backend for hybrid search: local | cohere | none
# Default "none": eval/results/retrieval_eval.md shows both options hurt MRR
# on this bilingual corpus versus plain hybrid search.
RERANKER=none

# Query rewriting before retrieval: heuristic | auto | off
# Default "heuristic" is free (regex only). "auto" scores the best MRR in
# eval/results/retrieval_eval.md but spends one Cohere call on each long
# English sentence-like query — enable only if your Cohere quota allows it.
QUERY_REWRITE=heuristic

# ── Ingestion pipeline (Prefect) ─────────────────────────────────────────────
# Quiets Prefect's task-run banners in container logs; the pipeline's own
# progress output still shows (log_prints=True). Set in docker-compose already.
# PREFECT_LOGGING_LEVEL=WARNING
