# Copy to .env and fill in:  cp .env.example .env

# ── LLM provider (grammar explanations / optional query rewrite) ─────────────
# Switch backends with one line. Set the matching API key.
LLM_PROVIDER=nebius
NEBIUS_API_KEY=your-nebius-api-key-here
#GROQ_API_KEY=your-groq-api-key-here
#GEMINI_API_KEY=your-gemini-api-key-here
#COHERE_API_KEY=your-cohere-api-key-here

#   nebius — https://tokenfactory.nebius.com/
#   groq   — https://console.groq.com/keys
#   gemini — https://aistudio.google.com/apikey
#   cohere — https://dashboard.cohere.com/api-keys

# Optional model overrides (defaults are provider-specific — see app/llm.py).
# Leave unset when switching providers so the new provider's defaults apply.
#
# groq:
#LLM_MODEL=openai/gpt-oss-120b
#LLM_MODEL_FALLBACK=openai/gpt-oss-20b
#
# gemini (Flash is omitted — 20 requests/day free tier; Lite only):
#LLM_MODEL=gemini-3.5-flash-lite
#
# cohere:
#LLM_MODEL=command-a-plus-05-2026
#LLM_MODEL_FALLBACK=command-r-plus-08-2024
#
# nebius (exact catalog IDs — case-sensitive):
#LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
#LLM_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b
#
# Optional base-URL override (regional / self-hosted OpenAI-compatible endpoint).
#LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# ── Tuning ───────────────────────────────────────────────────────────────────
APP_PORT=8000                     # host port the app is published on (docker-compose)

QDRANT_HOST=localhost             # host development (Compose overrides this to qdrant)
QDRANT_PORT=6333
QDRANT_COLLECTION=jmdict_chunks   # collection holding the JMdict chunks

QUERY_REWRITE=auto  # heuristic (free, instant) | auto (+1 LLM pivot for long descriptive EN queries) | off

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2  # dense — see eval/reports/embed_model_bench.json
SPARSE_MODEL=Qdrant/bm25                            # BM25 arm of hybrid retrieval

#MODELS_DIR=models/fastembed      # model cache path (the Dockerfile sets its own)
#MONITORING_DB=data/monitoring/reikun.db

# ── Serving ──────────────────────────────────────────────────────────────────
# Telemetry sink for API requests: "stdout" emits one JSON line per event
# (stateless default), "sqlite" writes the monitoring DB. Search queries are
# stored raw; feedback/explanation text stays SHA-256-prefixed.
#TELEMETRY=stdout
# Comma-separated origins allowed to call the API cross-origin (the SvelteKit
# frontend's origin in production; "*" is the permissive dev default).
#CORS_ORIGINS=*

# ── Cloud ────────────────────────────────────────────────────────────────────
# Qdrant Cloud — set instead of HOST/PORT (QDRANT_URL wins)
#QDRANT_URL=https://<cluster>.<region>.qdrant.io
#QDRANT_API_KEY=your-qdrant-api-key

# Qdrant Cloud hosted inference: when enabled, Qdrant Cloud handles embedding
# (dense + sparse) via models.Document, removing FastEmbed/ONNX from the container.
# Requires QDRANT_URL (Cloud) and uses the free tier's request budget (1 fused call
# per /search). Model names must be fully qualified (see EMBED_MODEL/SPARSE_MODEL).
#QDRANT_CLOUD_INFERENCE=false

# The app's listen port inside the container — some hosts inject this themselves;
# never set it manually for local/compose (the container always uses 8000 there).
#PORT=8000

# In-container ingest is a one-shot compose prefix, not an .env setting:
#   INGEST_VIA_DOCKER=1 docker compose up -d --build
