# Copy to .env and fill in:  cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────
# Grammar explanations, QUERY_REWRITE=auto, LLM eval. Search/kanji/dashboard
# work without it. Key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key-here

# ── Tuning ───────────────────────────────────────────────────────────────────
APP_PORT=8000                     # host port the app is published on (docker-compose)

QDRANT_HOST=localhost             # local/self-hosted (matches docker-compose)
QDRANT_PORT=6333
QDRANT_COLLECTION=jmdict_chunks   # collection holding the JMdict chunks

QUERY_REWRITE=heuristic  # heuristic (free) | auto (+1 Cohere call per long EN query) | off

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2  # dense — see eval/results/embed_model_bench.json
SPARSE_MODEL=Qdrant/bm25                            # BM25 arm of hybrid retrieval
COHERE_MODEL=command-a-plus-05-2026                 # explanations / rewrite / LLM judge

#MODELS_DIR=models/fastembed      # model cache path (the Dockerfile sets its own)
#MONITORING_DB=data/monitoring/reikun.db

# ── Cloud ────────────────────────────────────────────────────────────────────
# Qdrant Cloud — set instead of HOST/PORT (QDRANT_URL wins)
#QDRANT_URL=https://<cluster>.<region>.qdrant.io
#QDRANT_API_KEY=your-qdrant-api-key
# The app's listen port inside the container — Render injects this itself;
# never set it manually (local/compose always use the 8501 default).
#PORT=8501

# Single knob for ingestion: when set, compose passes it as a build arg (rsync
# + dev deps into the image) AND it's baked into the image env, so the
# container runs the download → build → ingest pipeline on boot. Unset = lean
# image that just serves.
#INGEST_VIA_DOCKER=

# Ingest only — api.github.com caps unauthenticated calls at 60 req/hr;
# any empty-scope PAT works (the repo is public).
#GITHUB_TOKEN=github_pat_…
