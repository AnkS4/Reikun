# Upload context for `gcloud run deploy --source .` (Cloud Build builds the
# Dockerfile from whatever is uploaded, so this mirrors .dockerignore).
# Anything not COPY'd in the Dockerfile is dead weight on the wire.

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Environment & secrets — never uploaded
.env
.env.*
!.env.example

# Data (populated at runtime or build-time inputs; the per-language runtime
# artifacts are explicitly kept)
data/raw/
data/processed/*
!data/processed/ja/
data/processed/ja/*
!data/processed/ja/kanji_table.json
!data/processed/ja/headword_index.marisa
!data/processed/ja/strokes.json
data/monitoring/
data/work/

# Models (pre-warmed in Dockerfile)
models/

# Evaluation outputs
eval/

# Git & metadata
.git/
.gitignore
.gitattributes
.dockerignore
.gcloudignore

# Docs, frontend, CI config — the only frontend bytes the API image
# needs are the self-hosted Plex mirror for lite's /lite/fonts
# (web/static/fonts/, see d2a5c59); everything else in web/ is SPA
# source the image never copies.
README.md
docs/
web/*
!web/static/
web/static/*
!web/static/fonts/
.github/
docker-compose*.yml
tests/

# IDE & misc
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.log
local/
