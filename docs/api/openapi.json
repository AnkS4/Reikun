            "type": "string",
            "title": "Literal"
          },
          "meanings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Meanings",
            "default": []
          },
          "on_yomi": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "On Yomi",
            "default": []
          },
          "kun_yomi": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Kun Yomi",
            "default": []
          },
          "meta": {
            "items": {
              "$ref": "#/components/schemas/MetaBadge"
            },
            "type": "array",
