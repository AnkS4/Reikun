                "type": "null"
              }
            ],
            "title": "Okurigana"
          }
        },
        "type": "object",
        "required": [
          "stem"
        ],
        "title": "ReadingChip",
        "description": "One on/kun reading; `okurigana` is the part after KANJIDIC2's dot (た.べる)."
      },
      "RewriteInfo": {
        "properties": {
          "original": {
            "type": "string",
            "title": "Original"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "changed": {
            "type": "boolean",
            "title": "Changed"
          }
        },
        "type": "object",
        "required": [
          "original",
          "query",
          "method",
          "changed"
        ],
        "title": "RewriteInfo"
      },
      "RubyPart": {
        "properties": {
          "text": {
            "type": "string",
