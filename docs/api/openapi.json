        ],
        "title": "RubyPart",
        "description": "One display segment of a headword: `rt` carries the furigana when set."
      },
      "SearchResponseModel": {
        "properties": {
          "search_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Id"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "rewrite": {
            "$ref": "#/components/schemas/RewriteInfo"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms"
          },
          "segments": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Segment"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Segments"
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "results",
          "rewrite",
          "mode",
          "latency_ms"
        ],
        "title": "SearchResponseModel"
      },
      "SearchResult": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "kanji_form": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Kanji Form"
          },
          "reading": {
            "type": "string",
            "title": "Reading",
            "default": ""
          },
          "kanji_forms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Kanji Forms",
