{
	// Same-origin Worker for reikun.app: static SPA assets from web/build/ +
	// a reverse proxy for the API and the lite UI (web/worker.js). Serving
	// /api and /lite from reikun.app instead of the raw Cloud Run origin is
	// what makes the cross-variant theme/recent-searches cookies work —
	// cookies are host-scoped, and run.app vs reikun.app are different
	// registrable domains. `main` handles:
	//   /api/*  → proxy to API_URL, /api prefix stripped (the SPA bakes
	//             PUBLIC_API_BASE=/api at build time)
	//   /lite*  → proxy to API_URL, path as-is (the server-rendered no-JS variant)
	//   (other) → assets; unmatched → the neutral SPA shell (200.html)
	// Committed config also stops `wrangler deploy`'s SvelteKit auto-config
	// from trying to convert the project to adapter-cloudflare.
	"name": "reikun",
	"compatibility_date": "2026-10-01",
	"main": "./worker.js",
	"assets": {
		"directory": "./build",
		// The ASSETS binding lets the fetch handler read the neutral SPA shell
		// (200.html) for paths the router cannot match.
		"binding": "ASSETS",
		// The proxy paths must reach the Worker FIRST — the assets router
		// otherwise answers (or claims) them before any fetch-handler logic.
		// Patterns, not plain prefixes: "/api/*" does not match "/api" itself.
		"run_worker_first": ["/api", "/api/*", "/lite", "/lite/*"],
		// Unmatched paths are handled by the Worker's fetch handler, which
		// serves the neutral SPA shell (200.html). NOT
		// "single-page-application": that mode serves index.html, and
		// index.html is the *prerendered home page* — the client would
		// hydrate it as "/" and render the home page for every deep link
		// (e.g. /kanji-group?by=grade&value=1).
		"not_found_handling": "none"
	},
	// Keep-alive cron (web/worker.js): one /ready hit per day stops the Qdrant
	// Cloud free cluster from auto-pausing. Daily is the cheapest valid cron
	// under the multi-day pause threshold ("*/48" isn't expressible).
	"triggers": {
		"crons": ["17 9 * * *"]
	},
	"vars": {
		"API_URL": "https://reikun-api-cmudl7elbq-no.a.run.app"
	},
	// PROXY_TOKEN (shared secret with the API's PROXY_IDENTITY_TOKEN, signing
	// the client-IP header for the rate limiter) intentionally has no value
	// here: it is a dashboard/secret-store managed value — plaintext `vars`
	// entries would overwrite it on deploy, and secrets are never deleted by
	// one (Wrangler treats the config as the vars source of truth only).
	// Declaring it required makes every build fail loudly when it is missing
	// instead of silently falling back to the shared-egress XFF identity.
	"secrets": {
		"required": ["PROXY_TOKEN"]
	},
	"observability": {
		"enabled": true
	}
}
