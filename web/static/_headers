# Cloudflare static-assets headers (ignored by other hosts).
# Hashed build output never changes under the same URL — cache it for a year.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: woff2 filenames carry a content hash — immutable. The
# manifest itself is unhashed, so keep it short-lived.
/fonts/files/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/fonts.css
  Cache-Control: public, max-age=3600

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Clickjacking: nothing legitimate frames this app.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
