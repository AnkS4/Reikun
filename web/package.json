{
  "name": "reikun-web",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node tools/sync-assets.mjs && vite build",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen:api": "npx --yes openapi-typescript@7.13.0 ../docs/api/openapi.json -o src/lib/openapi.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "openapi-fetch": "^0.17.0"
  }
}
