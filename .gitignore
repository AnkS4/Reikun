# Data (downloaded/generated at runtime)
data/raw/
# processed/chunks.json is generated locally by build_chunks.py (58 MB, only
# needed by the ingest step). kanji_table.json is committed — the app needs it
# at runtime and it is small enough (~4 MB) to ship in the Docker image.
data/processed/*
!data/processed/kanji_table.json
!data/processed/headword_index.marisa
!data/processed/strokes.json
data/kanjivg/
data/monitoring/
data/snapshots/

